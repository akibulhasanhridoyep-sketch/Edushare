* text=auto

# Unix line endings for all text files
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Binary files
*.mp4 binary
*.mov binary
*.pdf binary
*.jpg binary
*.png binary
*.gif binary
